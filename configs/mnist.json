{
  "name": "mnist",
  "task": "mnist",
  "data_dir": "data/mnist",
  "output_dir": "runs/mnist",
  "model": {
    "hidden_size": 512,
    "num_heads": 8,
    "ffn_hidden_size": 512,
    "num_layers": 2,
    "mixer": "attention",
    "pos_encoding": "rope",
    "hierarchical": true,
    "low_level_steps": 4,
    "high_level_steps": 3,
    "n_supervision": 16,
    "deep_supervision": true,
    "guidance": "full",
    "use_act": true,
    "act_mode": "halt_only",
    "use_lprm": true,
    "vocab_size": 3,
    "seq_len": 196,
    "patch_encoder": {
      "image_size": 28,
      "in_channels": 1,
      "patch_size": 2,
      "conv_kernel": 5,
      "group_norm_groups": 32,
      "enabled": true
    }
  },
  "train": {
    "batch_size": 768,
    "lr": 0.0001,
    "weight_decay": 1.0,
    "grad_clip": 1.0,
    "warmup_steps": 200,
    "beta": 0.07,
    "kl_balance": 0.8,
    "ema_decay": 0.9999,
    "seed": 0,
    "device": "auto",
    "eval_interval": 50,
    "log_interval": 50,
    "checkpoint_interval": 500,
    "head_rollout": "prior",
    "epochs": 1800
  },
  "eval": {
    "num_samples": 1,
    "selection": "majority",
    "use_act": false,
    "batch_size": 128,
    "coverage_samples": 20
  }
}
