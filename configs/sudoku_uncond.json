{
  "name": "sudoku_uncond",
  "task": "sudoku",
  "data_dir": "data/sudoku_uncond",
  "output_dir": "runs/sudoku_uncond",
  "model": {
    "hidden_size": 512,
    "num_heads": 8,
    "ffn_hidden_size": 512,
    "num_layers": 2,
    "mixer": "mlp",
    "pos_encoding": "learned",
    "hierarchical": true,
    "low_level_steps": 6,
    "high_level_steps": 3,
    "n_supervision": 16,
    "deep_supervision": true,
    "guidance": "full",
    "use_act": true,
    "act_mode": "halt_only",
    "use_lprm": true,
    "vocab_size": 11,
    "seq_len": 81
  },
  "train": {
    "batch_size": 768,
    "lr": 0.0001,
    "weight_decay": 1.0,
    "grad_clip": 1.0,
    "warmup_steps": 200,
    "beta": 0.05,
    "kl_balance": 0.8,
    "ema_decay": 0.999,
    "seed": 0,
    "device": "auto",
    "eval_interval": 10,
    "log_interval": 50,
    "checkpoint_interval": 500,
    "head_rollout": "prior",
    "epochs": 200
  },
  "eval": {
    "num_samples": 1,
    "selection": "majority",
    "use_act": false,
    "batch_size": 256,
    "coverage_samples": 20
  }
}
